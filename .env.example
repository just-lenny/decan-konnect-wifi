# --- Public (safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server only. NEVER prefix with NEXT_PUBLIC_ ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Production domain, no trailing slash. Used for portal URLs and Daraja callback URLs.
APP_BASE_URL=https://decankonnect.co.ke
# 32 random bytes, base64.  openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Random string, >= 32 chars.  openssl rand -base64 48
VOUCHER_PEPPER=
# Protects /api/v1/cron/maintenance.  openssl rand -base64 32
CRON_SECRET=
# true = a Daraja callback is only trusted after STK Query confirms it
MPESA_VERIFY_CALLBACK_WITH_QUERY=true
